# Copy to .env and fill in (never commit .env).
OPENAI_API_KEY=
PORT=3000

# Required for app persistence locally and on Vercel.
MONGODB_URI=

# Optional test-only fallback when MONGODB_URI is omitted.
# Leave false for normal development/deployment.
ALLOW_SQLITE_FALLBACK=false
SQLITE_PATH=./data/paper.sqlite

# Optional; used only to obtain a fresh blockhash for the unbroadcast ownership proof.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Live Pump.fun creator reward pool. The displayed pool is the 0.5 SOL base plus 45%
# of currently accrued creator rewards across the Pump bonding curve and PumpSwap vaults.
PAPER_CREATOR_WALLET=
PAPER_TOKEN_MINT=
REWARD_POOL_BASE_SOL=0.5
CREATOR_REWARD_SHARE_PERCENT=45
CREATOR_REWARD_CACHE_MS=60000
CREATOR_REWARD_RPC_TIMEOUT_MS=10000

# Used by GET /api/paper-secrets -> merged into window.PAPER_SECRETS (Helius + Solana Tracker).
# Required for: paper-ai wallet tools, demo trading migrated tab / search, demo terminal charts/trades.
# Add the same names in Vercel -> Project -> Settings -> Environment Variables.
HELIUS_API_KEY=
# Also accepted: HELIUS_KEY
SOLANA_TRACKER_API_KEY=
# Also accepted: SOLANA_TRACKER_KEY, SOLANATRACKER_API_KEY

# Browser-only (demo terminal, demo trading, paper-ai.js): set window.PAPER_SECRETS
# before scripts load, e.g. DevTools, or a gitignored scripts/local-secrets.js included
# before ../scripts/bootstrap-secrets.js. Keys: openai, helius, solanaTracker.
#
# Wallet analysis in paper-ai.js uses Helius only (no server proxy yet):
#   helius - https://www.helius.dev/ (DAS getAssetsByOwner + enhanced transactions API)
# DexScreener (public) is used for token prices; Solana public RPC for balance fallback.
